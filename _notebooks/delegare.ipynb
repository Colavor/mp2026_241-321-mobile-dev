   "source": [
    "delegate void Work();\n",
    "\n",
    "void Hello() => Console.WriteLine(\"Hello\");\n",
    "void HowAreYou() => Console.WriteLine(\"How are you?\");\n",
    "\n",
    "// Однотипный делегат\n",
    "Work work = Hello;\n",
    "work = HowAreYou;\n",
    "\n",
    "// work();\n",
    "work.Invoke();"
   ]
